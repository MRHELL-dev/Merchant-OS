{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merchant OS",
  "version": "0.1.0",
  "identifier": "com.merchantos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Merchant OS",
        "width": 900,
        "height": 650,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
